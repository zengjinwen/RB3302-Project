Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.6
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Name: Grid
    Plane Cell Count: 20
    Enabled: true
  - Class: rviz_default_plugins/RobotModel
    Description Topic:
      Value: /robot_description
    Name: RobotModel
    Enabled: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
  - Alpha: 1
    Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
    Size (m): 0.02
    Enabled: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Name: Map
    Topic:
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /map
    Enabled: true
  - Class: nav2_rviz_plugins/ParticleCloud
    Name: AMCL particles
    Enabled: true
    Topic:
      Value: /particle_cloud
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Map
    Name: A* planning costmap (static)
    Enabled: true
    Alpha: 0.4
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /planning_costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Planned route
    Enabled: true
    Topic:
      Value: /plan
    Color: 40; 210; 80
    Line Style: Lines
    Line Width: 0.03
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Name: Current View
      Pitch: 1.0
      Yaw: 0.8
    Saved: null
Window Geometry:
  Height: 900
  Width: 1600
  X: 50
  Y: 50
